# ── Optional — ElevenLabs API key ───────────────────────────────────────

# Fallback ElevenLabs API key, used for requests that don't supply their
# own via the xi-api-key header. Leave unset to require every caller to
# bring their own key (requests without one get a 401).
ELEVENLABS_API_KEY=your_api_key_here


# ── Optional — ElevenLabs API location ──────────────────────────────────

# Base host for the ElevenLabs API. Override if pointing at a proxy, mock
# server, or a regional/enterprise endpoint. Defaults to the value below.
ELEVENLABS_API_BASE=https://api.elevenlabs.io

# Versioned resource path for the TTS endpoint. Not currently consumed by
# the official SDK client (it builds its own paths), kept for reference /
# in case of a future raw-HTTP fallback. Defaults to the value below.
ELEVENLABS_TTS_PATH=/v1/text-to-speech


# ── Optional — chunking behavior ────────────────────────────────────────

# Headroom below ElevenLabs' hard 10,000 character limit per request, used
# when a caller doesn't supply their own chunk_indexes. Defaults to 9500.
DEFAULT_MAX_CHUNK_CHARS=9500


# ── Optional — logging ───────────────────────────────────────────────────

# Standard library logging level: DEBUG, INFO, WARNING, or ERROR.
# DEBUG also logs voice settings and silence-gap configuration.
# Defaults to INFO.
LOG_LEVEL=INFO