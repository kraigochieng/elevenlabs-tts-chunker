# syntax=docker/dockerfile:1
#
# Vercel-specific variant of ../Dockerfile. Vercel builds any Dockerfile.vercel
# it finds at the repo root into a container-backed Function instead of using
# its native Python runtime. Kept as a separate file (not a symlink) because
# Vercel functions must listen on the port given via $PORT rather than a
# fixed one — everything else mirrors the plain Dockerfile. If the build
# steps below ever change, mirror the change there too.

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Install dependencies first so this layer is cached independently of
# application code changes.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev

COPY src ./src
COPY README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev


FROM python:3.12-slim AS runtime

# pydub shells out to ffmpeg to merge/encode audio chunks.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system app && useradd --system --gid app --no-create-home app

WORKDIR /app
COPY --from=builder --chown=app:app /app/.venv ./.venv
COPY --chown=app:app src ./src

ENV PATH="/app/.venv/bin:$PATH"

USER app

EXPOSE 8000

# Shell form (with `exec`, so uvicorn becomes PID 1 and gets signals
# directly) so $PORT — which Vercel injects — is honored, falling back to
# 8000 if it's ever unset (e.g. testing this file with a plain `docker run`).
CMD exec /app/.venv/bin/uvicorn elevenlabs_tts_chunker.main:app --host 0.0.0.0 --port ${PORT:-8000}
